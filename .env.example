# Copiar a .env.local y cargar las mismas variables en Vercel. Solo se usan en el servidor.

# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Tiendanube: user_id y access_token obtenidos al instalar tu app en la tienda
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
# Obligatorio para la API: nombre de la app y un contacto
TIENDANUBE_USER_AGENT=ERP Ventas (tu-email@ejemplo.com)
# Opcional: solo hace falta si la tienda tiene más de una ubicación de stock
TIENDANUBE_LOCATION_ID=

# Credenciales de acceso al panel (HTTP Basic). Sin ellas, el panel responde 503.
ADMIN_USER=
ADMIN_PASSWORD=
